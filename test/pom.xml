<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>marketplace-lite</artifactId>
        <groupId>dk.ku.di.dms.vms.marketplacelite</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>test</artifactId>

    <dependencies>
        <dependency>
            <groupId>dk.ku.di.dms.vms</groupId>
            <artifactId>coordinator</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>dk.ku.di.dms.vms.marketplacelite</groupId>
            <artifactId>product</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>dk.ku.di.dms.vms.marketplacelite</groupId>
            <artifactId>cart</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <!-- vMODB compiles with the preview-features flag (memory segments); the test JVM needs it too -->
                    <argLine>--enable-preview --add-exports java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                    <!-- One fresh JVM per test class (not Surefire's default reuseForks=true): VMODB's
                         repository-proxy class generation cannot run twice in the same classloader, and
                         every test class here boots its own product/cart VmsApplication instances.
                         Confirmed: running two such test classes in one shared fork failed the second
                         with "Cannot inject already loaded type: class ProductRepositoryImpl". forkCount
                         stays 1 so test classes still run sequentially, avoiding port conflicts between
                         them instead of needing per-class port configuration. -->
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
