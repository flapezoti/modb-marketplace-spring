<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dk.ku.di.dms.vms</groupId>
        <artifactId>vms-runtime-java</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <name>vmodb-marketplace</name>
    <artifactId>marketplace-lite</artifactId>
    <groupId>dk.ku.di.dms.vms.marketplacelite</groupId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>ports</module>
        <module>common</module>
        <module>product</module>
        <module>cart</module>
        <module>product-redis</module>
        <module>cart-redis</module>
        <module>coordinator-launcher</module>
        <module>test</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- modb-api/sdk-embed moved from a blanket <dependencies> block (inherited by every child,
         including product-redis/cart-redis and ports, which must NOT depend on VMODB at all) to
         <dependencyManagement>: now each module that actually uses VMODB types declares that
         dependency explicitly (common, product, cart; see their own poms), instead of getting it
         for free by being in this reactor. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.16</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dk.ku.di.dms.vms</groupId>
                <artifactId>modb-api</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>dk.ku.di.dms.vms</groupId>
                <artifactId>sdk-embed</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
