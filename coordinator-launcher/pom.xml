<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>marketplace-lite</artifactId>
        <groupId>dk.ku.di.dms.vms.marketplacelite</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>coordinator-launcher</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Deliberately depends on nothing from this repo, not product, not cart, not common, not
         ports. The coordinator has zero compile-time coupling to application code (its DAG is
         built from plain strings), and this module exists to prove that by construction: it
         only ever touches dk.ku.di.dms.vms:coordinator, VMODB's own public API, the same way
         Kafka or Redis never need to know about the services that use them. -->
    <dependencies>
        <dependency>
            <groupId>dk.ku.di.dms.vms</groupId>
            <artifactId>coordinator</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A runnable jar with dependencies bundled, so `java -jar` is all that is needed,
                 no classpath assembly required to run this as its own process. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>marketplace.coordinator.CoordinatorMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
